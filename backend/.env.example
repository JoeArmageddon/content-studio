# Copy to .env and fill in as each milestone needs the credential.
# Nothing here is required for Milestone 1 (stub agents run with no keys at all).

# Core
DATABASE_URL=
SCHEDULER_ENABLED=false
SCHEDULER_START_HOUR=8

# Reddit (Milestone 2) — register a fresh app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ContentStudioBot/0.1

# LLMs (Milestone 3) — both have free tiers
GROQ_API_KEY=
GEMINI_API_KEY=

# Voice (Milestone 4) — Edge-TTS needs no key; ElevenLabs is optional/manual
ELEVENLABS_API_KEY=

# Background footage (Milestone 5)
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_DATA_API_KEY=

# YouTube upload (Milestone 6) — one OAuth client, ten channel authorizations
YOUTUBE_OAUTH_CLIENT_SECRETS_PATH=
